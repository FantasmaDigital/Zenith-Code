# ==========================================================
# PLANTILLA DE CONFIGURACIÓN DEL SISTEMA - ZENITH CODE (.env.example)
# Copia este archivo como '.env' y completa tus credenciales.
# ==========================================================
COMPANY_NAME=Tu Empresa o Marca
BOT_NAME=Asistente Operativo
BOT_TONE=Profesional, directo, resolutivo y empático.
BRAND_INSTRUCTIONS=Priorizar cotizaciones y resolución de dudas sin alucinaciones.

# ==========================================================
# PROVEEDOR DE IA: 'gemini' u 'openai' (Failover Automático)
# ==========================================================
AI_PROVIDER=gemini

# Google Gemini (Motor Principal)
GEMINI_API_KEY=AIzaSy...tu_clave_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Motor de Respaldo)
OPENAI_API_KEY=sk-...tu_clave_de_openai
OPENAI_MODEL=gpt-4o-mini

# ==========================================================
# SERVICIO FASTAPI (BACKEND PYTHON)
# ==========================================================
HOST=0.0.0.0
PORT=8000
DEBUG=True
PYTHON_BACKEND_PORT=8000

# ==========================================================
# BASE DE DATOS POSTGRESQL (PERSISTENCIA & HOT CACHE)
# ==========================================================
DATABASE_URL=postgresql://zenith:zenith_password_2026@localhost:5432/zenith_knowledge

# ==========================================================
# MICROSERVICIO IN-HOUSE DE WHATSAPP (BAILEYS MULTI-DEVICE)
# ==========================================================
WHATSAPP_GATEWAY_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://localhost:8000
WHATSAPP_GATEWAY_PORT=3000
AUTH_FOLDER=./auth_info_baileys
LOG_LEVEL=info
INITIAL_RECONNECT_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=30000

# ==========================================================
# SEGURIDAD (OBLIGATORIO) - genera valores aleatorios, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==========================================================
# Contraseña para entrar al panel y a la página /qr del gateway
ADMIN_PASSWORD=cambia_esta_contraseña
# Clave compartida entre whatsapp-gateway y backend-python (header X-Internal-Key)
INTERNAL_API_KEY=genera_una_clave_larga_y_aleatoria
# Firma de los tokens del panel (si cambia, todos deben volver a iniciar sesión)
AUTH_SECRET=genera_otra_clave_larga_y_aleatoria
# Orígenes del panel autorizados por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Contraseña de PostgreSQL en Docker (solo aplica al crear el volumen por primera vez)
POSTGRES_PASSWORD=cambia_esta_contraseña_de_bd

# ==========================================================
# CANAL DE WHATSAPP: 'baileys' (QR, económico) o 'meta' (Cloud API oficial)
# Todo esto también se configura desde el panel: WhatsApp → Canal de WhatsApp
# ==========================================================
WHATSAPP_CHANNEL=baileys
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v21.0
# URL pública HTTPS del backend; el webhook de Meta queda en ${PUBLIC_BASE_URL}/webhook/meta
PUBLIC_BASE_URL=
