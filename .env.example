# ==========================================================
# PLANTILLA DE CONFIGURACIÓN DEL SISTEMA - ZENITH CODE (.env.example)
# Copia este archivo como '.env' y completa tus credenciales.
# ==========================================================
COMPANY_NAME=Tu Empresa o Marca
BOT_NAME=Asistente Operativo
BOT_TONE=Profesional, directo, resolutivo y empático.
BRAND_INSTRUCTIONS=Priorizar cotizaciones y resolución de dudas sin alucinaciones.

# ==========================================================
# PROVEEDOR DE IA: 'gemini' u 'openai' (Failover Automático)
# ==========================================================
AI_PROVIDER=gemini

# Google Gemini (Motor Principal)
GEMINI_API_KEY=AIzaSy...tu_clave_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Motor de Respaldo)
OPENAI_API_KEY=sk-...tu_clave_de_openai
OPENAI_MODEL=gpt-4o-mini

# ==========================================================
# SERVICIO FASTAPI (BACKEND PYTHON)
# ==========================================================
HOST=0.0.0.0
PORT=8000
DEBUG=True
PYTHON_BACKEND_PORT=8000

# ==========================================================
# BASE DE DATOS POSTGRESQL (PERSISTENCIA & HOT CACHE)
# ==========================================================
DATABASE_URL=postgresql://zenith:zenith_password_2026@localhost:5432/zenith_knowledge

# ==========================================================
# MICROSERVICIO IN-HOUSE DE WHATSAPP (BAILEYS MULTI-DEVICE)
# ==========================================================
WHATSAPP_GATEWAY_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://localhost:8000
WHATSAPP_GATEWAY_PORT=3000
AUTH_FOLDER=./auth_info_baileys
LOG_LEVEL=info
INITIAL_RECONNECT_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=30000
