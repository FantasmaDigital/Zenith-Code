# --- Build estático del panel ---
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# VITE_API_BASE se incrusta en el build: URL pública del backend (https://api.tudominio.com)
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

# --- Servidor estático ---
FROM nginx:1.27-alpine
ARG VITE_API_BASE
COPY nginx.conf /etc/nginx/conf.d/default.conf
# La CSP del panel solo permite hablar con su propia API
RUN sed -i "s#__API_ORIGIN__#${VITE_API_BASE:-}#" /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
