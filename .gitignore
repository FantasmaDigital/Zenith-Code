# ==============================================================
# ZENITH CODE - REPOSITORIO OFICIAL .GITIGNORE DETALLADO
# ==============================================================

# --------------------------------------------------------------
# 1. ARCHIVOS DE CONFIGURACIÓN Y CREDENCIALES SECRETAS (CRÍTICO)
# --------------------------------------------------------------
# Bloquear cualquier archivo .env con claves API reales
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Claves criptográficas y certificados SSL
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# --------------------------------------------------------------
# 2. PERSISTENCIA DE SESIÓN WHATSAPP BAILEYS (NUNCA SUBIR)
# --------------------------------------------------------------
# Contiene los tokens de autenticación QR y sesión activa de WhatsApp
auth_info_baileys/
*/auth_info_baileys/
*/*/auth_info_baileys/
baileys_auth_data/
*/baileys_auth_data/
*.auth/
*.session/
session-*.json
creds.json
*creds*.json

# --------------------------------------------------------------
