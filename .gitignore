# --------------------------------------------------------------
venv/
.venv/
env/
.env_python/
ENV/
env.bak/
venv.bak/

# Bytecode compilado de Python
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Empaquetado y distribución de Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
